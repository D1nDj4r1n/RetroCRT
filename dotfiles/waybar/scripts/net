#!/bin/sh
# retrocrt — Waybar network for FreeBSD (custom/net).
# Waybar's network module needs Linux netlink (the FreeBSD port builds it
# without libnl), so this reads route(8) and ifconfig(8) from the base system.
# Prints one line of Waybar JSON; class: up (wired), wifi, or down.

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

emit() { # text tooltip class
  printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' \
    "$(json_escape "$1")" "$(json_escape "$2")" "$3"
}

iface=$(route -n get default 2>/dev/null | awk '$1 == "interface:" { print $2; exit }')
if [ -z "$iface" ]; then
  emit "NET --" "no default route" down
  exit 0
fi

info=$(ifconfig "$iface" 2>/dev/null)
ip=$(printf '%s\n' "$info" | awk '$1 == "inet" { print $2; exit }')
# ifconfig prints: ssid "My Net" channel 6 ... (quotes only when needed)
ssid=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*ssid \(.*\) channel .*/\1/p' | head -n 1)
case $ssid in
  \"*\") ssid=${ssid#\"}; ssid=${ssid%\"} ;;
esac

if [ -z "$ip" ]; then
  emit "NET $iface --" "$iface: no IPv4 address" down
elif [ -n "$ssid" ]; then
  emit "NET $ssid" "$iface $ip ($ssid)" wifi
else
  emit "NET $iface $ip" "$iface $ip" up
fi
