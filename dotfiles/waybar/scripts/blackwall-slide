#!/bin/sh
# Blackwall menu "Slide": leave the Tails session, then lock the screen.
# The only sudo in the bar; the sudoers rule allows exactly this command.
# sudo -n never waits for a password (there is no terminal to type it in).
. "$(dirname -- "$0")/lib.sh"

session=${JACK_STATE_DIR:-/var/run/jack}/session
if [ ! -e "$session" ]; then
  notify 'Blackwall' 'No Tails session to slide out of.'
  exit 0
fi

sudo -n /usr/local/bin/jack slide
rc=$?
if [ "$rc" -ne 0 ]; then
  notify 'Blackwall' "jack slide failed (exit $rc); locking the screen anyway."
fi
if has swaylock; then
  exec swaylock -f
fi
notify 'Blackwall' 'No swaylock: the screen is NOT locked.'
exit 1
