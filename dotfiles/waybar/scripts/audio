#!/bin/sh
# Volume through OSS mixer(8) from the base system (FreeBSD 14+ syntax);
# no PulseAudio, PipeWire or sndiod. Click mutes, scroll +-5% (config).
# Class: zielony on, off muted or no mixer.
. "$(dirname -- "$0")/lib.sh"

vol=$(mixer vol.volume 2> /dev/null)   # vol.volume=0.75:0.75
mute=$(mixer vol.mute 2> /dev/null)    # vol.mute=off
case $vol in
  vol.volume=[0-9]*) ;;
  *) emit '--' off 'Sound: no OSS mixer (mixer vol)'; exit 0 ;;
esac
left=${vol#*=}
left=${left%%:*}
pct=$(printf '%s\n' "$left" | awk '{ printf "%d", $1 * 100 + 0.5 }')
if [ "$mute" = vol.mute=on ]; then
  emit 'mute' off "Sound: muted ($pct%)" "$pct"
else
  emit "$pct%" zielony "Sound: $pct% (OSS, mixer vol)" "$pct"
fi
