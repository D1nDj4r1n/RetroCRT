#!/bin/sh
# ICE clicks: left opens iced-tui in Kitty; the right-click menu only raises
# protection. Nothing here lowers it: that is done in iced-tui, with
# confirmation. Arguments are fixed words from config; nothing from the
# state files reaches this script.
# Usage: ice-action tui|raise|snapshot
. "$(dirname -- "$0")/lib.sh"

if ! has iced-tui; then
  notify 'ICE' 'iced-tui nie jest jeszcze zainstalowany.'
  exit 0
fi

case ${1-} in
  tui)
    if has kitty; then exec kitty --class iced-tui --title iced-tui iced-tui; fi
    if has foot; then exec foot --app-id iced-tui iced-tui; fi
    notify 'ICE' 'Brak terminala (kitty, foot).'
    ;;
  raise)
    if iced-tui --quickhack 4; then notify 'ICE' 'Poziom podniesiony.'
    else notify 'ICE' "Podniesienie poziomu nie powiodło się (kod $?)."; fi
    ;;
  snapshot)
    if iced-tui --quickhack 2; then notify 'ICE' 'Snapshot wykonany.'
    else notify 'ICE' "Snapshot nie powiódł się (kod $?)."; fi
    ;;
  *)
    notify 'ICE' 'Nieznana akcja.'
    exit 2
    ;;
esac
