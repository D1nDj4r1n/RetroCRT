#!/bin/sh
# VPN state from vpnmgr, through a small status command.
# vpnmgr has no status command yet, so this module is ready to be hooked up:
# install an executable named vpnmgr-bar (in PATH, no root) that asks the
# vpnmgr daemon over its unix socket and prints ONE line:
#
#   STATE [key=value ...]
#   STATE  UP | CONNECTING | DOWN | ERROR
#   keys   [A-Za-z0-9_.-]+, values without spaces, printable ASCII,
#          at most 1024 bytes, at most 32 fields, exit status 0
#   e.g.   UP name=pl-waw if=wg1 since=2026-11-02T14:31:00Z
#
# Until then the module shows "VPN --" (off). vpnmgr itself is never called
# here: an unknown subcommand could start its TUI or daemon.
. "$(dirname -- "$0")/lib.sh"

if ! has vpnmgr-bar; then
  emit 'VPN --' off 'VPN: ready, waiting for vpnmgr-bar (format in scripts/vpn)'
  exit 0
fi

if has timeout; then
  data=$(timeout 3 vpnmgr-bar 2> /dev/null | head -c 1025)
else
  data=$(vpnmgr-bar 2> /dev/null | head -c 1025)
fi
if [ ${#data} -gt 1024 ] || ! kv_line UP CONNECTING DOWN ERROR; then
  emit 'VPN ?' czerwony 'VPN: invalid answer from vpnmgr-bar'
  exit 0
fi

name=$(printf '%s\n' "$kv_fields" | sed -n 's/^name=//p' | head -n 1)
case $kv_word in
  UP) cls=zielony; text="VPN ${name:-up}" ;;
  CONNECTING) cls=zolty; text='VPN …' ;;
  DOWN) cls=off; text='VPN off' ;;
  *) cls=czerwony; text='VPN !' ;;
esac
emit "$text" "$cls" "VPN: $kv_word$kv_fields"
