<?xml version="1.0" encoding="UTF-8"?>
<!-- ICE right-click menu (GtkBuilder, GTK 3). Only actions that RAISE
     protection; ids match "menu-actions" in modules/ice.jsonc. Lowering
     protection is not available from the bar: iced-tui, with confirmation. -->
<interface>
  <object class="GtkMenu" id="menu">
    <child>
      <object class="GtkMenuItem" id="raise">
        <property name="label">Raise level</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="snapshot">
        <property name="label">Snapshot now</property>
      </object>
    </child>
  </object>
</interface>
