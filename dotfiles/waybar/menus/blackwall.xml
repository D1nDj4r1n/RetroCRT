<?xml version="1.0" encoding="UTF-8"?>
<!-- Blackwall right-click menu: leave the Tails session, then lock. -->
<interface>
  <object class="GtkMenu" id="menu">
    <child>
      <object class="GtkMenuItem" id="slide">
        <property name="label">Slide (leave the session and lock)</property>
      </object>
    </child>
  </object>
</interface>
