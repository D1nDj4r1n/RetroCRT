// retrocrt — Waybar for FreeBSD (Sway). Arch keeps swaybar.
// Installed as ~/.config/waybar/config.jsonc by ./install.sh --dotfiles on FreeBSD.
// Sway runs it from ~/.config/sway/config:   bar { swaybar_command waybar }
//
// Only modules the FreeBSD port builds and that need no daemon:
//   network  -> custom/net   (the port builds Waybar without libnl/netlink)
//   audio    -> custom/audio (OSS mixer(8) from base; no PulseAudio/sndiod)
//   battery  -> none         (the FreeBSD machine is a PC; see README "Laptop or PC")
// Labels are text, as the tmux battery (BAT 87%): no icon font needed.
{
  "layer": "top",
  "position": "top",
  "spacing": 0,

  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["custom/net", "custom/audio", "cpu", "memory", "temperature", "tray", "clock"],

  "sway/workspaces": {
    "disable-scroll": true,
    "format": "{name}"
  },
  // Binding mode by name (resize, ...), as the tmux key table
  "sway/mode": {
    "format": "{}"
  },
  "sway/window": {
    "max-length": 60
  },

  "custom/net": {
    "exec": "~/.config/waybar/scripts/net",
    "return-type": "json",
    "escape": true,
    "interval": 10
  },
  // Click mutes, scroll changes the volume; the script runs again after each.
  "custom/audio": {
    "exec": "~/.config/waybar/scripts/audio",
    "return-type": "json",
    "interval": 5,
    "on-click": "mixer vol.mute=toggle",
    "on-scroll-up": "mixer vol.volume=+5%",
    "on-scroll-down": "mixer vol.volume=-5%"
  },

  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%",
    "states": { "warning": 70, "critical": 90 }
  },
  "memory": {
    "interval": 10,
    "format": "MEM {percentage}%",
    "states": { "warning": 80, "critical": 95 }
  },
  // dev.cpu.0.temperature (kld coretemp or amdtemp), else hw.acpi.thermal.tz0
  "temperature": {
    "thermal-zone": 0,
    "critical-threshold": 80,
    "format": "TMP {temperatureC}°C"
  },
  "tray": {
    "spacing": 8
  },
  "clock": {
    "interval": 30,
    "format": "{:%Y-%m-%d %H:%M}",
    "tooltip-format": "{:%A %d %B %Y}"
  }
}
