# retrocrt color adapter for Powerlevel10k.
# This file intentionally does not redesign prompt segments or typography.

typeset -g POWERLEVEL9K_VI_MODE_NORMAL_FOREGROUND="${CYAN:-#00d4c8}"
typeset -g POWERLEVEL9K_VI_MODE_NORMAL_BACKGROUND="${BACKGROUND_ALT:-#121820}"
typeset -g POWERLEVEL9K_VI_MODE_INSERT_FOREGROUND="${AMBER:-#ffb020}"
