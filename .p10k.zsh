typeset -g POWERLEVEL9K_STATUS_OK_FOREGROUND="${GREEN:-#40c070}"
typeset -g POWERLEVEL9K_STATUS_ERROR_FOREGROUND="${RED:-#e05050}"
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND="${AMBER:-#ffb020}"
