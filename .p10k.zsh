typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_VICMD_FOREGROUND="${CYAN:-#00d4c8}"
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_VICMD_FOREGROUND="${RED:-#e05050}"
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_VIVIS_FOREGROUND="${MAGENTA:-#e040a0}"
