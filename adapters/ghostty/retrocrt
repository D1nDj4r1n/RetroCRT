# retrocrt — Ghostty adapter
# Canonical palette: ../../palette
# Install to ~/.config/ghostty/themes/retrocrt
# Enable with one line in ~/.config/ghostty/config:
#   theme = retrocrt
# Do not put font, padding, opacity, or window behavior in this file.

background = #0a0e14
foreground = #c8d0d8
# BACKGROUND_ALT (#121820) has no Ghostty slot; one terminal surface only.
cursor-color = #00d4c8
cursor-text = #0a0e14
selection-background = #1e3a4c
selection-foreground = #c8d0d8

# ANSI 0-7
palette = 0=#0a0e14
palette = 1=#e05050
palette = 2=#40c070
palette = 3=#ffb020
palette = 4=#4080c0
palette = 5=#e040a0
palette = 6=#00d4c8
palette = 7=#c8d0d8

# ANSI 8-15 (derived brights, same hues)
palette = 8=#5a6570
palette = 9=#e67373
palette = 10=#66cd8d
palette = 11=#ffc04d
palette = 12=#6699cd
palette = 13=#e666b3
palette = 14=#33ddd3
palette = 15=#d8e0e8
