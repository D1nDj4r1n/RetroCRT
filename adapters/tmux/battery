#!/bin/sh
# retrocrt — tmux battery fragment (Linux sysfs, FreeBSD sysctl)
# Prints a tmux style string. No plugins.
# Healthy GREEN, low AMBER, critical RED. No battery: DIM.

GREEN=#40c070
AMBER=#ffb020
RED=#e05050
DIM=#5a6570

cap=""
st=""
for d in /sys/class/power_supply/*; do
  [ -d "$d" ] || continue
  t=$(cat "$d/type" 2>/dev/null) || continue
  [ "$t" = "Battery" ] || continue
  cap=$(cat "$d/capacity" 2>/dev/null) || cap=""
  st=$(cat "$d/status" 2>/dev/null) || st=""
  break
done

# FreeBSD: no /sys/class/power_supply. hw.acpi.battery.life is a percentage,
# hw.acpi.battery.state is a bitmask (1 discharging, 2 charging, 4 critical).
if [ -z "$cap" ] && [ "$(uname -s 2>/dev/null)" = FreeBSD ]; then
  life=$(sysctl -n hw.acpi.battery.life 2>/dev/null) || life=""
  case "$life" in
    ''|*[!0-9]*) ;;
    *)
      cap=$life
      bst=$(sysctl -n hw.acpi.battery.state 2>/dev/null) || bst=0
      case "$bst" in
        ''|*[!0-9]*) bst=0 ;;
      esac
      [ $((bst & 2)) -ne 0 ] && st=Charging
      ;;
  esac
fi

if [ -z "$cap" ]; then
  printf '#[fg=%s]BAT --' "$DIM"
  exit 0
fi

color=$GREEN
if [ "$cap" -le 15 ] 2>/dev/null; then
  color=$RED
elif [ "$cap" -le 30 ] 2>/dev/null; then
  color=$AMBER
fi

suffix=""
case "$st" in
  Charging) suffix="+" ;;
esac

printf '#[fg=%s]BAT %s%%%s' "$color" "$cap" "$suffix"
