# ~/.zshrc fragment — retrocrt
# Preserve this order. Do not load syntax-highlighting earlier.

# ... Oh My Zsh plugins array, including zsh-autosuggestions ...
# source $ZSH/oh-my-zsh.sh
# [[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
# source .../zsh-syntax-highlighting.zsh   # LAST plugin

source ~/.config/retrocrt/adapters/zsh/retrocrt.zsh
