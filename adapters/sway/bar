# Optional standalone swaybar using retrocrt colors.
# Include this only if you do not already define a bar { } block:
#   include ~/.config/retrocrt/adapters/sway/bar
#
# Does not set status_command, font, or position.

bar {
    colors {
        background #0a0e14
        statusline #c8d0d8
        separator #5a6570
        focused_workspace  #00d4c8 #00d4c8 #0a0e14
        active_workspace   #5a6570 #121820 #00d4c8
        inactive_workspace #121820 #121820 #5a6570
        urgent_workspace   #e05050 #201212 #c8d0d8
        binding_mode       #ffb020 #ffb020 #0a0e14
    }
}
