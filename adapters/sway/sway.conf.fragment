# ~/.config/sway/config fragment — retrocrt
# Colors only. Keep binds, outputs, input, and gaps.
#
# Sway is the main WM and Kitty the main terminal on every device. Start from
# the default config (Arch: /etc/sway/config, FreeBSD: /usr/local/etc/sway/config)
# and change its terminal line, which sets foot, before the bindings that use it:
#   set $term kitty

include ~/.config/retrocrt/adapters/sway/colors

# Wallpaper as a solid surface (optional; leave commented if you use an image):
# output * bg #0a0e14 solid_color

# Arch (swaybar): if you already have a bar { } block, copy
# adapters/sway/bar-colors into its colors { } section. Otherwise you may:
# include ~/.config/retrocrt/adapters/sway/bar
#
# FreeBSD (Waybar, see README WAYBAR): replace the bar { } block with
# bar { swaybar_command waybar }
