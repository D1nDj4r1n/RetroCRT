# retrocrt — mako adapter
# Canonical palette: ../../palette
# Install to ~/.config/mako/config
# Colors only. Do not put font, timeout, or position here.

background-color=#121820
text-color=#c8d0d8
border-color=#00d4c8
progress-color=over #00d4c8

[urgency=low]
border-color=#5a6570
text-color=#5a6570

[urgency=normal]
border-color=#00d4c8
text-color=#c8d0d8

[urgency=critical]
background-color=#201212
border-color=#e05050
text-color=#c8d0d8
